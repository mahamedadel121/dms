# Copy to .env. Loaded from repo root by loadEnv() in @dms/db.
DATABASE_URL=postgresql://postgres@localhost:54329/dms
# Directory with pg binaries; default on Windows is C:\Program Files\PostgreSQL\17\bin, PATH elsewhere
PG_BIN=
API_PORT=4000
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
FILE_URL_SECRET=dev-file-url-secret-change-me
STORAGE_DRIVER=local
STORAGE_ROOT=./storage-data
BOT_TOKEN=
BOT_MODE=polling
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=4100
SAP_ADAPTER=mock
SAP_S4_URL=
SAP_S4_USER=
SAP_S4_PASSWORD=
SAP_S4_CLIENT=
# empty = bundled Chromium; use msedge or chrome if the bundled browser is not installed
PDF_BROWSER_CHANNEL=
WORKER_CONCURRENCY=2
LOG_LEVEL=info
# web build dir (parallel work packages use .next-wp6 / .next-wp7)
NEXT_DIST_DIR=.next
