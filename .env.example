# Copy to .env. Loaded from repo root by loadEnv() in @dms/db.
DATABASE_URL=postgresql://postgres@localhost:54329/dms
# Directory with pg binaries; default on Windows is C:\Program Files\PostgreSQL\17\bin, PATH elsewhere
PG_BIN=
API_PORT=4000
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
FILE_URL_SECRET=dev-file-url-secret-change-me
STORAGE_DRIVER=local
STORAGE_ROOT=./storage-data
BOT_TOKEN=
BOT_MODE=polling
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=4100
SAP_ADAPTER=mock
SAP_S4_URL=
SAP_S4_USER=
SAP_S4_PASSWORD=
SAP_S4_CLIENT=
# empty = bundled Chromium; use msedge or chrome if the bundled browser is not installed
PDF_BROWSER_CHANNEL=
WORKER_CONCURRENCY=2
LOG_LEVEL=info
# web build dir (parallel work packages use .next-wp6 / .next-wp7)
NEXT_DIST_DIR=.next

# --- SAP S/4HANA lookup and cash journal (SAP_ADAPTER=s4hana | s4hana-cj)
SAP_S4_TIMEOUT_MS=30000
SAP_S4_LOGICAL_SYSTEM=
# lookup mode: odata | none (none never re-posts after an unknown outcome without a human force)
SAP_S4_LOOKUP_MODE=odata
SAP_S4_ODATA_URL=
SAP_S4_LOOKUP_SERVICE=API_JOURNALENTRYITEMBASIC_SRV
SAP_S4_LOOKUP_ENTITY=A_JournalEntryItemBasic
SAP_S4_LOOKUP_REF_FIELD=DocumentReferenceID
SAP_S4_DUPLICATE_PATTERN=already (been )?posted|duplicate
SAP_S4_CJ_URL=
SAP_S4_CJ_FUNCTION=BAPI_CASHJOURNALDOC_CREATE

# --- S3 storage (STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
S3_PRESIGNED_REDIRECT=false

# --- E-mail (EMAIL_DRIVER=none | smtp | file)
EMAIL_DRIVER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DMS <no-reply@localhost>
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Metrics (GET /metrics bearer token; empty = endpoint disabled)
METRICS_TOKEN=

# --- Telegram account link
BOT_USERNAME=
TELEGRAM_LINK_TTL_SEC=900
